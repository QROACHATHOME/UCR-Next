<Window x:Class="UcrNext.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:UcrNext.App"
        Title="{Binding WindowTitle}" Width="1360" Height="800" MinWidth="980" MinHeight="520">
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
                <MenuItem Header="_Revert to saved" Command="{Binding RevertCommand}" />
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="Re_do" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="Export selected profile to a file…" Click="ExportProfile_Click" />
                <MenuItem Header="Import profile from a file…" Click="ImportProfileFile_Click" />
                <MenuItem Header="Import UCR profiles (context.xml)…" Click="ImportUcr_Click" />
                <MenuItem Header="Open profiles folder" Click="OpenProfiles_Click" />
                <Separator />
                <MenuItem Header="Hide to background" Click="HideWindow_Click" />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Copy profile" Click="CopyProfile_Click" />
                <MenuItem Header="Paste profile or bindings" Click="Paste_Click" />
                <MenuItem Header="Duplicate profile" Click="DuplicateProfile_Click" />
                <MenuItem Header="Delete profile" Click="DeleteProfile_Click" />
                <Separator />
                <MenuItem Header="New group" Click="AddGroup_Click" />
                <MenuItem Header="Group bindings by controller" Click="AutoGroup_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Follow Windows (light or dark)" IsCheckable="True" IsChecked="{Binding ThemeSystem, Mode=OneWay}" Click="ThemeSystem_Click" />
                <MenuItem Header="Light" IsCheckable="True" IsChecked="{Binding ThemeLight, Mode=OneWay}" Click="ThemeLight_Click" />
                <MenuItem Header="Dark" IsCheckable="True" IsChecked="{Binding ThemeDark, Mode=OneWay}" Click="ThemeDark_Click" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="Device slots and extra players…" Click="DeviceSlots_Click"
                          ToolTip="Bindings can read a slot (&quot;P1 stick&quot;) instead of one exact controller; extra players are UCR's shadow devices" />
                <Separator />
                <MenuItem Header="Start mapping when UCR-Next starts" IsCheckable="True" IsChecked="{Binding StartMappingOnLaunch}" />
                <MenuItem Header="Show tray icon" IsCheckable="True" IsChecked="{Binding ShowTrayIcon}" Click="TraySetting_Click" />
                <MenuItem Header="Keep running in the tray when the window is closed" IsCheckable="True" IsChecked="{Binding CloseToTray}" />
                <Separator />
                <MenuItem Header="Start with Windows (hidden)">
                    <MenuItem Header="Off" IsCheckable="True" IsChecked="{Binding AutostartOff, Mode=OneWay}" Click="AutostartOff_Click" />
                    <MenuItem Header="At logon" IsCheckable="True" IsChecked="{Binding AutostartLogon, Mode=OneWay}" Click="AutostartLogon_Click" />
                    <MenuItem Header="At logon, as administrator (for games running as admin)" IsCheckable="True"
                              IsChecked="{Binding AutostartElevated, Mode=OneWay}" Click="AutostartElevated_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Use Interception driver (per-device keyboard/mouse, restart required)" IsCheckable="True"
                          IsChecked="{Binding UseInterception}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Command-line usage" Click="CliHelp_Click" />
                <MenuItem Header="Driver and device status" Click="Details_Click" />
            </MenuItem>
        </Menu>

        <!-- Top bar: mapping switch, live status, save / undo -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="10,8,10,4" Padding="10,8">
            <DockPanel>
                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource MappingToggle}"
                              IsChecked="{Binding IsMapping}" Content="{Binding MappingButtonText}"
                              ToolTip="Turn mapping on or off. Ctrl+Alt+Pause always stops it." />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding UndoCommand}" AutomationProperties.Name="Undo" ToolTip="Undo (Ctrl+Z)" />
                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowRedo24}" Command="{Binding RedoCommand}" AutomationProperties.Name="Redo" ToolTip="Redo (Ctrl+Y)" />
                    <ui:Button Icon="{ui:SymbolIcon ArrowCounterclockwise24}" Content="Revert" Command="{Binding RevertCommand}" Margin="6,0,0,0"
                               ToolTip="Throw away unsaved changes and go back to the saved profiles (Undo brings them back)" />
                    <ui:Button Icon="{ui:SymbolIcon Save24}" Content="Save" Appearance="Primary" Command="{Binding SaveCommand}" Margin="6,0,0,0"
                               ToolTip="Save your changes (Ctrl+S). Changes are tried out live as you make them, but only kept once saved." />
                </StackPanel>
                <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,3" Margin="10,0" VerticalAlignment="Center"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}"
                        ToolTip="Your edits are already active, so you can try them out. Save keeps them; Revert goes back.">
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Unsaved changes" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="{Binding LiveText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailsText}" />
                    <TextBlock Text="{Binding PadStatus}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="12,5" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid Margin="10,4,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="300" MinWidth="180" />
            </Grid.ColumnDefinitions>

            <!-- Profiles -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Add24}" Click="AddProfile_Click" AutomationProperties.Name="New profile" ToolTip="New profile" />
                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon DocumentCopy24}" Click="DuplicateProfile_Click" AutomationProperties.Name="Duplicate profile" ToolTip="Duplicate profile (Ctrl+D)" />
                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Copy24}" Click="CopyProfile_Click" AutomationProperties.Name="Copy profile to the clipboard" ToolTip="Copy profile to the clipboard (Ctrl+C)" />
                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ClipboardPaste24}" Click="Paste_Click" AutomationProperties.Name="Paste a profile or bindings" ToolTip="Paste a profile or bindings (Ctrl+V)" />
                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Delete24}" Click="DeleteProfile_Click" AutomationProperties.Name="Delete profile" ToolTip="Delete profile (Del) — can be undone until you save" />
                        </StackPanel>
                        <TextBlock Text="Profiles" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <ui:ListView x:Name="ProfileList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}"
                             HorizontalContentAlignment="Stretch" KeyDown="ProfileList_KeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ui:ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="New profile" Click="AddProfile_Click" />
                                <MenuItem Header="Duplicate" InputGestureText="Ctrl+D" Click="DuplicateProfile_Click" />
                                <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="CopyProfile_Click" />
                                <MenuItem Header="Paste" InputGestureText="Ctrl+V" Click="Paste_Click" />
                                <Separator />
                                <MenuItem Header="Export to a file…" Click="ExportProfile_Click" />
                                <MenuItem Header="Import from a file…" Click="ImportProfileFile_Click" />
                                <Separator />
                                <MenuItem Header="Delete" InputGestureText="Del" Click="DeleteProfile_Click" />
                            </ContextMenu>
                        </ui:ListView.ContextMenu>
                        <ui:ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ProfileVm}">
                                <DockPanel Margin="0,3">
                                    <ui:ToggleSwitch DockPanel.Dock="Left" VerticalAlignment="Center" Margin="4,0,8,0"
                                                     IsChecked="{Binding Enabled}" ToolTip="Profile on/off (takes effect and is saved at once)" />
                                    <TextBlock DockPanel.Dock="Right" Text="●" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               VerticalAlignment="Top" Margin="4,2,0,0" ToolTip="Unsaved changes"
                                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <ItemsControl ItemsSource="{Binding GroupBrushes}" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate><Ellipse Width="8" Height="8" Fill="{Binding}" Margin="0,0,3,0" /></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Faint}" Margin="2,0,0,0" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Outputs}" Margin="0,3,0,1" ToolTip="What this profile outputs">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,1" ToolTip="{Binding ToolTip}">
                                                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Text}" FontSize="11" Margin="3,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding AppsSummary}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding GamesSummary}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ui:ListView.ItemTemplate>
                    </ui:ListView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Bindings of the selected profile -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10,8">
                <DockPanel x:Name="BindingsPanel" DataContext="{Binding Selected}">
                    <DockPanel.RenderTransform><TranslateTransform /></DockPanel.RenderTransform>
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Icon="{ui:SymbolIcon Add24}" Content="Binding" Click="AddBinding_Click" ToolTip="Add a binding and press the input to use" />
                            <ui:Button Icon="{ui:SymbolIcon GroupList24}" Content="Group" Click="AddGroup_Click" ToolTip="New group: give it a name and colour, e.g. the controller its bindings belong to" />
                            <ui:Button Icon="{ui:SymbolIcon XboxController24}" Content="Group by controller" Click="AutoGroup_Click"
                                       ToolTip="Put every binding that isn't in a group into a group per input device" />
                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ClipboardPaste24}" Click="Paste_Click" AutomationProperties.Name="Paste bindings into this profile" ToolTip="Paste bindings into this profile" />
                        </StackPanel>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="15" FontWeight="SemiBold"
                                 Margin="0,0,10,0" ToolTip="Profile name" />
                    </DockPanel>
                    <!-- What the profile outputs, at a glance -->
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                        <TextBlock Text="Outputs:" Style="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="nothing yet — pick an output on a binding" Style="{StaticResource Faint}" VerticalAlignment="Center"
                                   Visibility="{Binding HasNoOutputs, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Outputs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,2" Margin="0,0,6,2" ToolTip="{Binding ToolTip}"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="15" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Text}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Count, StringFormat=' ({0})'}" Style="{StaticResource Faint}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                    <Expander DockPanel.Dock="Top" Header="Profile settings: programs, games, devices" Margin="0,0,0,8" IsExpanded="False">
                        <!-- One setting per row: title and explanation on the left, the control on the right.
                             Scrolls inside a limited height so the bindings below stay in view. -->
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="6,10,14,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Programs -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Programs" FontWeight="SemiBold" />
                                <TextBlock Text="Only active while one of these programs is in front. Empty = everywhere." Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBox Text="{Binding ApplicationsText, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Comma-separated, e.g. game.exe, emulator.exe. Leave empty to use the profile everywhere." />
                                <Button HorizontalAlignment="Left" Content="Add running program ▾" Click="AddApp_Click" Margin="0,8,0,0" />
                            </StackPanel>
                            <Separator Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14" Opacity="0.5" />

                            <!-- Games -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Games" FontWeight="SemiBold" />
                                <TextBlock Text="Games that use this profile, one per line. Launchers can enable it with 'ucrnext game'." Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBox Grid.Row="2" Grid.Column="2" MinHeight="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     Text="{Binding GamesText, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="For your reference, and for launchers: 'ucrnext game &quot;Game name&quot;' enables the profile(s) listing that game." />
                            <Separator Grid.Row="3" Grid.ColumnSpan="3" Margin="0,14" Opacity="0.5" />

                            <!-- Skip while connected -->
                            <StackPanel Grid.Row="4" Grid.Column="0">
                                <TextBlock Text="Skip while connected" FontWeight="SemiBold" />
                                <TextBlock Text="The profile stays off, and creates no virtual controller, while any of these devices is plugged in (e.g. your real wheel)." Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2">
                                <ItemsControl ItemsSource="{Binding SkipDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,4">
                                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss16}"
                                                           Click="RemoveSkipDevice_Click" ToolTip="Remove" />
                                                <TextBlock VerticalAlignment="Center" Text="{Binding}" ToolTip="{Binding DeviceId}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button HorizontalAlignment="Left" Content="Add connected device ▾" Click="AddSkipDevice_Click" />
                            </StackPanel>
                            <Separator Grid.Row="5" Grid.ColumnSpan="3" Margin="0,14" Opacity="0.5" />

                            <!-- Wait for controllers -->
                            <StackPanel Grid.Row="6" Grid.Column="0">
                                <TextBlock Text="Wait for controllers" FontWeight="SemiBold" />
                                <TextBlock Text="Stay off until every controller the bindings read is connected, so no virtual pad is plugged in for a missing controller." Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Row="6" Grid.Column="2" VerticalAlignment="Top" IsChecked="{Binding RequireDevices}"
                                      Content="Wait until its controllers are connected"
                                      ToolTip="Real pads then keep their Xbox slots, because a virtual pad never takes a slot ahead of them." />
                        </Grid>
                        </ScrollViewer>
                    </Expander>

                    <!-- Column titles -->
                    <Grid DockPanel.Dock="Top" Margin="14,0,26,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="3*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource Faint}" />
                        <TextBlock Grid.Column="2" Text="Input (press Bind…)" Style="{StaticResource Faint}" />
                        <TextBlock Grid.Column="3" Text="Output" Style="{StaticResource Faint}" />
                        <TextBlock Grid.Column="4" Text="Deadzone / Sensitivity / Options" Style="{StaticResource Faint}" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,12" FontSize="13"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                               Text="No bindings yet. Click + Binding and press the button, key or stick you want to remap. Use + Group to sort bindings by controller (or let Group by controller do it), and paste bindings copied from another profile with the clipboard button." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <!-- One group: coloured header + its bindings -->
                                <DataTemplate DataType="{x:Type local:GroupVm}">
                                    <Border Margin="0,0,0,10" CornerRadius="8" BorderThickness="1" ClipToBounds="True"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            Background="{DynamicResource LayerFillColorDefaultBrush}">
                                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Border.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="10" To="0" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                        <DockPanel>
                                            <!-- colour bar down the left side -->
                                            <Border DockPanel.Dock="Left" Width="5" Background="{Binding Brush}" />
                                            <StackPanel>
                                                <!-- header -->
                                                <Border Background="{Binding TintBrush}" Padding="4,4,6,4"
                                                        Visibility="{Binding ShowHeader, Converter={StaticResource BoolToVis}}">
                                                    <DockPanel>
                                                        <ui:Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Click="ToggleGroup_Click" ToolTip="Fold / unfold">
                                                            <ui:SymbolIcon Symbol="ChevronDown16" Style="{StaticResource Chevron}" RenderTransformOrigin="0.5,0.5">
                                                                <ui:SymbolIcon.RenderTransform><RotateTransform /></ui:SymbolIcon.RenderTransform>
                                                            </ui:SymbolIcon>
                                                        </ui:Button>
                                                        <Button DockPanel.Dock="Left" Click="GroupColor_Click" ToolTip="Group colour" Padding="0" Margin="2,0,8,0"
                                                                Width="20" Height="20" MinWidth="0" MinHeight="0" Background="{Binding Brush}" BorderThickness="0"
                                                                Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Ellipse Fill="{TemplateBinding Background}" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" Cursor="Hand" />
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Add24}" Click="AddBindingToGroup_Click" AutomationProperties.Name="Add a binding to this group" ToolTip="Add a binding to this group" />
                                                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon MoreHorizontal24}" Click="GroupMenu_Click" AutomationProperties.Name="More" ToolTip="More: copy, paste, move, delete" />
                                                        </StackPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Faint}" VerticalAlignment="Center"
                                                                   Margin="8,0" MaxWidth="320" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
                                                        <Grid>
                                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" MaxWidth="320" HorizontalAlignment="Left" MinWidth="160"
                                                                     Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}" ToolTip="Group name" />
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Style="{StaticResource Muted}"
                                                                       Visibility="{Binding IsUngrouped, Converter={StaticResource BoolToVis}}" />
                                                        </Grid>
                                                    </DockPanel>
                                                </Border>
                                                <!-- rows -->
                                                <ItemsControl ItemsSource="{Binding Bindings}" Style="{StaticResource Collapsible}">
                                                    <ItemsControl.LayoutTransform><ScaleTransform /></ItemsControl.LayoutTransform>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type local:BindingVm}">
                                                            <Border Style="{StaticResource Row}" Padding="6,5">
                                                                <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                                                                <Border.Triggers>
                                                                    <EventTrigger RoutedEvent="Border.Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-8" To="0" Duration="0:0:0.25">
                                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </Border.Triggers>
                                                                <StackPanel>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="40" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="4*" />
                                                                            <ColumnDefinition Width="3*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="72" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <CheckBox Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0" Padding="0" IsChecked="{Binding Enabled}" ToolTip="Binding enabled" MinWidth="0" />
                                                                        <TextBox Grid.Column="1" Margin="2" VerticalContentAlignment="Center"
                                                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                                        <DockPanel Grid.Column="2" Margin="2">
                                                                            <Button DockPanel.Dock="Right" Content="Bind…" Click="BindInput_Click" />
                                                                            <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="4" ClipToBounds="True" Margin="2,0,2,0"
                                                                                    VerticalAlignment="Center" ToolTip="{Binding DeviceToolTip}"
                                                                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                                                <Grid>
                                                                                    <Image Source="{Binding DeviceImage}" Stretch="UniformToFill"
                                                                                           Visibility="{Binding HasDeviceImage, Converter={StaticResource BoolToVis}}" />
                                                                                    <ui:SymbolIcon Symbol="{Binding DeviceIcon}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                                   Visibility="{Binding HasDeviceIcon, Converter={StaticResource BoolToVis}}" />
                                                                                </Grid>
                                                                            </Border>
                                                                            <TextBlock VerticalAlignment="Center" Margin="4,0" Text="{Binding InputText}" TextTrimming="CharacterEllipsis"
                                                                                       ToolTip="{Binding InputText}" />
                                                                        </DockPanel>
                                                                        <ComboBox Grid.Column="3" Margin="2" ItemsSource="{Binding Outputs}"
                                                                                  SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Display"
                                                                                  IsTextSearchEnabled="True" TextSearch.TextPath="Display"
                                                                                  Visibility="{Binding NeedsOutput, Converter={StaticResource BoolToVis}}" />
                                                                        <StackPanel Grid.Column="4" Margin="4,0,2,0" VerticalAlignment="Center">
                                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsAnalogInput, Converter={StaticResource BoolToVis}}">
                                                                                <Slider Width="78" Minimum="0" Maximum="0.9" Value="{Binding Deadzone}"
                                                                                        ToolTip="{Binding Deadzone}" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                                                                                <Slider Width="78" Margin="6,0,0,0" Minimum="0.1" Maximum="3" Value="{Binding Sensitivity}"
                                                                                        ToolTip="{Binding Sensitivity}" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                                                                            </StackPanel>
                                                                            <WrapPanel>
                                                                                <CheckBox Content="Invert" IsChecked="{Binding Invert}" Margin="0,0,8,0" MinWidth="0" />
                                                                                <CheckBox Content="Block" IsChecked="{Binding Block}" MinWidth="0"
                                                                                          Visibility="{Binding IsBlockable, Converter={StaticResource BoolToVis}}"
                                                                                          ToolTip="While mapping is on, the original key/button does not reach other programs." />
                                                                                <TextBlock Text="can't block" Style="{StaticResource Faint}" FontStyle="Italic" VerticalAlignment="Center"
                                                                                           Visibility="{Binding ShowBlockHint, Converter={StaticResource BoolToVis}}"
                                                                                           ToolTip="This key is bound to one specific keyboard/mouse through Raw Input, which can only watch input. To block it: bind it from 'any keyboard' (blocks it on all keyboards), or turn on Settings → Use Interception driver and bind it again (blocks it on that keyboard only)." />
                                                                                <CheckBox Content="Full range" IsChecked="{Binding TriggerFullRange}" MinWidth="0"
                                                                                          Visibility="{Binding CanUseFullRange, Converter={StaticResource BoolToVis}}"
                                                                                          ToolTip="Use the whole axis travel for the trigger (pedals): fully released = 0%, fully pressed = 100%." />
                                                                            </WrapPanel>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon MoreHorizontal24}" Click="BindingMenu_Click" AutomationProperties.Name="Copy, duplicate, move to group" ToolTip="Copy, duplicate, move to group" />
                                                                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Delete24}" Click="DeleteBinding_Click" AutomationProperties.Name="Delete binding" ToolTip="Delete binding" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <!-- Second line: mode, extra inputs, settings, group -->
                                                                    <WrapPanel Margin="42,4,0,0">
                                                                        <TextBlock Text="Mode" VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="0,0,6,0" />
                                                                        <ComboBox MinWidth="140" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Margin="0,0,8,0" />
                                                                        <ItemsControl ItemsSource="{Binding Extras}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                                                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Muted}">
                                                                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=": " />
                                                                                        </TextBlock>
                                                                                        <TextBlock VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis"
                                                                                                   Text="{Binding Text, Mode=OneWay}" ToolTip="{Binding Text, Mode=OneWay}" />
                                                                                        <Button Content="Bind…" Click="BindExtra_Click" />
                                                                                    </StackPanel>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <ui:Button Icon="{ui:SymbolIcon Settings24}" Content="Settings" Click="BindingSettings_Click" ToolTip="All settings for this binding's mode" />
                                                                        <Border Visibility="{Binding HasConditions, Converter={StaticResource BoolToVis}}" CornerRadius="9" Padding="8,2" Margin="8,0,0,0"
                                                                                VerticalAlignment="Center" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                                                ToolTip="This binding only works while these states are on (! = while off). Change it in Settings.">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <ui:SymbolIcon Symbol="Filter24" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding ConditionsText}" FontSize="12" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <TextBlock Text="Group" VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="12,0,6,0" />
                                                                        <ComboBox MinWidth="150" ItemsSource="{Binding Owner.GroupChoices}" SelectedItem="{Binding Group}" ToolTip="Move this binding to another group">
                                                                            <ComboBox.ItemTemplate>
                                                                                <DataTemplate DataType="{x:Type local:GroupVm}">
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <Ellipse Width="10" Height="10" Fill="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                                                    </StackPanel>
                                                                                </DataTemplate>
                                                                            </ComboBox.ItemTemplate>
                                                                        </ComboBox>
                                                                        <TextBlock Text="{Binding ModeHint}" VerticalAlignment="Center" Style="{StaticResource Faint}" Margin="10,0,0,0" />
                                                                    </WrapPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Devices -->
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Detected devices" Style="{StaticResource SectionTitle}" Margin="2,0,0,2" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="2,0,2,6"
                               Text="Press something on a device and it lights up. Double-click to name it, add notes or a picture." />
                    <StackPanel DockPanel.Dock="Bottom" Margin="2,6,2,0">
                        <CheckBox Content="{Binding HiddenDevicesText}" IsChecked="{Binding ShowHiddenDevices}" MinWidth="0"
                                  Visibility="{Binding AnyHiddenDevices, Converter={StaticResource BoolToVis}}" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Faint}" Margin="0,4,0,0"
                                   Text="Xbox controllers use XInput; other sticks, wheels and pads use DirectInput. Each keyboard and mouse is also listed separately (Raw Input, or Interception when on)." />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding DeviceList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:DeviceVm}">
                                <Grid Margin="0,1" Opacity="{Binding RowOpacity}">
                                    <!-- flashes when the device is used -->
                                    <Border x:Name="Flash" CornerRadius="6" Background="#3322C55E" BorderBrush="#22C55E" BorderThickness="1" Opacity="0" />
                                    <Border x:Name="Row" CornerRadius="6" Padding="6,5" Background="Transparent" ToolTip="{Binding ToolTip}"
                                            MouseLeftButtonDown="DeviceRow_MouseDown">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Name, notes and picture…" Click="EditDevice_Click" />
                                                <MenuItem Header="Hide" Click="HideDevice_Click" />
                                                <MenuItem Header="Show again" Click="UnhideDevice_Click" />
                                                <Separator />
                                                <MenuItem Header="Copy device id" Click="CopyDeviceId_Click" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <DockPanel>
                                            <!-- picture or type icon -->
                                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="6" ClipToBounds="True" Margin="0,0,10,0"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}" VerticalAlignment="Top">
                                                <Grid>
                                                    <Image Source="{Binding Image}" Stretch="UniformToFill"
                                                           Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" />
                                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{Binding HasNoImage, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Border>
                                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Edit24}" VerticalAlignment="Top"
                                                       Click="EditDevice_Click" AutomationProperties.Name="Edit device" ToolTip="Name, notes and picture" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Faint}" TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Notes}" FontSize="11" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                           Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.7" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl></ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
