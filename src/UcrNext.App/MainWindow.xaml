<Window x:Class="UcrNext.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UcrNext.App"
        Title="UCR-Next — Universal Control Remapper" Width="1320" Height="740" MinWidth="960" MinHeight="480">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Hide to background" Click="HideWindow_Click" />
                <MenuItem Header="Open profiles folder" Click="OpenProfiles_Click" />
                <MenuItem Header="Import UCR profiles (context.xml)…" Click="ImportUcr_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="Start mapping when UCR-Next starts" IsCheckable="True" IsChecked="{Binding StartMappingOnLaunch}" />
                <MenuItem Header="Show tray icon" IsCheckable="True" IsChecked="{Binding ShowTrayIcon}" Click="TraySetting_Click" />
                <MenuItem Header="Keep running in the tray when the window is closed" IsCheckable="True" IsChecked="{Binding CloseToTray}" />
                <Separator />
                <MenuItem Header="Start with Windows (hidden)">
                    <MenuItem Header="Off" IsCheckable="True" IsChecked="{Binding AutostartOff, Mode=OneWay}" Click="AutostartOff_Click" />
                    <MenuItem Header="At logon" IsCheckable="True" IsChecked="{Binding AutostartLogon, Mode=OneWay}" Click="AutostartLogon_Click" />
                    <MenuItem Header="At logon, as administrator (for games running as admin)" IsCheckable="True"
                              IsChecked="{Binding AutostartElevated, Mode=OneWay}" Click="AutostartElevated_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Use Interception driver (per-device keyboard/mouse, restart required)" IsCheckable="True"
                          IsChecked="{Binding UseInterception}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Command-line usage" Click="CliHelp_Click" />
                <MenuItem Header="Driver and device status" Click="Details_Click" />
            </MenuItem>
        </Menu>

        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Background="#FFF2F2F2" BorderBrush="#FFD0D0D0" BorderThickness="0,0,0,1" Padding="6">
            <DockPanel>
                <ToggleButton DockPanel.Dock="Left" MinWidth="140" Padding="10,4" FontWeight="Bold"
                              IsChecked="{Binding IsMapping}" Content="{Binding MappingButtonText}"
                              ToolTip="Ctrl+Alt+Pause always stops mapping" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0" Foreground="#FF555555"
                           Text="{Binding PadStatus}" />
                <TextBlock VerticalAlignment="Center" Margin="12,0" Foreground="#FF333333" Text="{Binding LiveText}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailsText}" />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <!-- Profiles -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Profiles" FontWeight="Bold" Margin="2,0,0,4" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                    <Button Content="Add" Click="AddProfile_Click" />
                    <Button Content="Delete" Click="DeleteProfile_Click" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ProfileVm}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,4,0"
                                          IsChecked="{Binding Enabled}" ToolTip="Profile enabled" />
                                <StackPanel>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" />
                                    <TextBlock Text="{Binding AppsSummary}" FontSize="10" Foreground="#FF888888" Margin="2,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding GamesSummary}" FontSize="10" Foreground="#FF5A7FB0" Margin="2,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <!-- Bindings of the selected profile -->
            <DockPanel Grid.Column="2" DataContext="{Binding Selected}">
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,4">
                    <Button DockPanel.Dock="Right" Content="+ Add binding" Click="AddBinding_Click" />
                    <TextBlock VerticalAlignment="Center" FontWeight="Bold">
                        <Run Text="Bindings — " /><Run Text="{Binding Name, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
                <Expander DockPanel.Dock="Top" Header="Profile settings: programs, games, devices" Margin="0,0,0,6" IsExpanded="False">
                    <Grid Margin="4,6,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Only active while these programs are in front" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBox Margin="0,3" Text="{Binding ApplicationsText, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Comma-separated, e.g. game.exe, emulator.exe. Leave empty to use the profile everywhere." />
                            <Button HorizontalAlignment="Left" Content="Add running program ▾" Click="AddApp_Click" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Games that use this profile (one per line)" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBox Margin="0,3" Height="64" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding GamesText, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="For your reference, and for launchers: 'ucrnext game &quot;Game name&quot;' enables the profile(s) listing that game." />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Skip this profile while connected" FontWeight="SemiBold" TextWrapping="Wrap"
                                       ToolTip="If any of these devices is plugged in, the profile stays off and creates no virtual controller (e.g. your real wheel)." />
                            <ItemsControl Margin="0,3" ItemsSource="{Binding SkipDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <Button DockPanel.Dock="Right" Content="✕" Padding="4,0" Margin="2,0" Click="RemoveSkipDevice_Click" ToolTip="Remove" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding}" ToolTip="{Binding DeviceId}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button HorizontalAlignment="Left" Content="Add connected device ▾" Click="AddSkipDevice_Click" />
                        </StackPanel>
                    </Grid>
                </Expander>
                <Grid DockPanel.Dock="Top" Margin="4,0,24,2" TextElement.Foreground="#FF666666">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="3*" /><ColumnDefinition Width="160" /><ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Name" />
                    <TextBlock Grid.Column="2" Text="Input (press Bind…)" />
                    <TextBlock Grid.Column="3" Text="Output" />
                    <TextBlock Grid.Column="4" Text="Deadzone / Sensitivity / Options" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Bindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:BindingVm}">
                                <Border BorderBrush="#FFDDDDDD" BorderThickness="0,0,0,1" Padding="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="3*" /><ColumnDefinition Width="160" /><ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding Enabled}" ToolTip="Binding enabled" />
                                        <TextBox Grid.Column="1" Margin="2" VerticalContentAlignment="Center"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <DockPanel Grid.Column="2" Margin="2">
                                            <Button DockPanel.Dock="Right" Content="Bind…" Click="BindInput_Click" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding InputText}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding InputText}" />
                                        </DockPanel>
                                        <ComboBox Grid.Column="3" Margin="2" ItemsSource="{Binding Outputs}"
                                                  SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Display"
                                                  IsTextSearchEnabled="True" TextSearch.TextPath="Display" />
                                        <StackPanel Grid.Column="4" Margin="2">
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsAnalogInput, Converter={StaticResource BoolToVis}}">
                                                <Slider Width="75" Minimum="0" Maximum="0.9" Value="{Binding Deadzone}"
                                                        ToolTip="{Binding Deadzone}" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                                                <Slider Width="75" Minimum="0.1" Maximum="3" Value="{Binding Sensitivity}"
                                                        ToolTip="{Binding Sensitivity}" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox Content="Invert" IsChecked="{Binding Invert}" Margin="0,0,8,0" />
                                                <CheckBox Content="Block" IsChecked="{Binding Block}"
                                                          Visibility="{Binding IsBlockable, Converter={StaticResource BoolToVis}}"
                                                          ToolTip="While mapping is on, the original key/button does not reach other programs." />
                                                <CheckBox Content="Full range" IsChecked="{Binding TriggerFullRange}"
                                                          Visibility="{Binding CanUseFullRange, Converter={StaticResource BoolToVis}}"
                                                          ToolTip="Use the whole axis travel for the trigger (pedals): fully released = 0%, fully pressed = 100%." />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="5" Content="✕" Padding="4,0" ToolTip="Delete binding" Click="DeleteBinding_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" />

            <!-- Devices -->
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="Detected devices" FontWeight="Bold" Margin="2,0,0,4" />
                <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="#FF777777" Margin="2,4"
                           Text="Refreshes every second. Xbox controllers use XInput; other sticks, wheels and pads use DirectInput. With Interception on, each keyboard and mouse is listed separately." />
                <ListBox ItemsSource="{Binding Devices}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Foreground="#FF777777" FontSize="11" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Provider, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DeviceId, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
