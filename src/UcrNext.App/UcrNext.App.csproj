<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>UcrNext.App</RootNamespace>
    <AssemblyName>UCR-Next</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms implicit usings clash with WPF type names (Application, MessageBox, Binding…). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UcrNext.Core\UcrNext.Core.csproj" />
    <ProjectReference Include="..\UcrNext.Devices\UcrNext.Devices.csproj" />
    <!-- Builds ucrnext.exe (the CLI) into the same output folder as UCR-Next.exe. -->
    <ProjectReference Include="..\UcrNext.Cli\UcrNext.Cli.csproj" />
  </ItemGroup>
</Project>
