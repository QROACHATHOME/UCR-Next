<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>UcrNext.App</RootNamespace>
    <AssemblyName>UCR-Next</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms implicit usings clash with WPF type names (Application, MessageBox, Binding…). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UcrNext.Core\UcrNext.Core.csproj" />
    <ProjectReference Include="..\UcrNext.Devices\UcrNext.Devices.csproj" />
    <!-- Builds ucrnext.exe (the CLI) into the same output folder as UCR-Next.exe. -->
    <ProjectReference Include="..\UcrNext.Cli\UcrNext.Cli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
  <!-- UCR.exe: the same program under the original UCR's name, so frontends that run
       "UCR.exe -p Profile" start UCR-Next when it is installed in UCR's folder (see README). -->
  <Target Name="CopyUcrAlias" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).exe" DestinationFiles="$(OutDir)UCR.exe" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishUcrAlias" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)UCR.exe" SkipUnchangedFiles="true" />
  </Target>
</Project>
