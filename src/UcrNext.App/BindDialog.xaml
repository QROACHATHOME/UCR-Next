<Window x:Class="UcrNext.App.BindDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Press to bind" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="Press a button, key or trigger — or move a stick fully — on the device you want to bind." />
            <TextBlock Margin="0,8,0,0" Foreground="#FF777777" TextWrapping="Wrap"
                       Text="Esc cancels. The left mouse button is ignored here so you can click Cancel." />
            <CheckBox x:Name="AnyDeviceBox" Margin="0,10,0,0" IsChecked="True"
                      Content="Keyboard/mouse: accept it from any keyboard or mouse"
                      ToolTip="Untick to bind to the one keyboard or mouse you use. Works without drivers (Raw Input, can't block the original key); with Interception on it can also block." />
            <CheckBox x:Name="MovementBox" Margin="0,6,0,0" IsChecked="False"
                      Content="Capture mouse / trackball movement (move it firmly in one direction)"
                      ToolTip="Off by default so moving the mouse to click Cancel doesn't bind it." />
            <TextBlock x:Name="CountdownText" Margin="0,8,0,0" Foreground="#FF777777" />
        </StackPanel>
    </DockPanel>
</Window>
